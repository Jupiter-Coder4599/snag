{
  "expo": {
    "name": "Snag",
    "slug": "snag",
    "scheme": "snag",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1B2025",
    "android": {
      "package": "com.jupiter.snag",
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "video",
            "photo"
          ],
          "savePhotosPermission": "Allow Snag to save photos and videos to your gallery."
        }
      ]
    ]
  }
}
